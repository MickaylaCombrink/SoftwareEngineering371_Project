# Base URL of the backend API. Vite only exposes variables prefixed VITE_.
# Never put a secret in here: everything VITE_ is compiled into the bundle
# and is readable by anyone who opens the site.
#
# Either spelling works - the API client normalises them:
#   http://localhost:5000        or   http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
