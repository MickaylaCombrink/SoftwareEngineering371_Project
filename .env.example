# ---------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.
# ---------------------------------------------------------------------

# server
NODE_ENV=development
PORT=5000

# database
# Local:  mongodb://localhost:27017/ecommerce_SEN371
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce_SEN371?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ecommerce_SEN371

# JWT security & authentication
JWT_SECRET=replace_with_a_32plus_byte_random_string
JWT_EXPIRES_IN=1d
# Optional: only needed once refresh tokens are switched on.
# Falls back to JWT_SECRET when unset.
JWT_REFRESH_SECRET=replace_with_a_different_32plus_byte_random_string
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Client (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
